# Copy values into your environment (or a process manager). All optional except ADMIN_TOKEN.
ADMIN_TOKEN=change-me-admin
# LLM: auto | gemini | ollama | none   (none = extractive quotes only)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=BAAI/bge-m3
# Retrieval evidence gate (cosine, e5 scale)
MIN_SIMILARITY=0.48
TOP_K=6
# Polite crawling
CRAWL_DELAY_SECONDS=1.5
MAX_PAGES_PER_RUN=45
MAX_PDFS_PER_RUN=25
